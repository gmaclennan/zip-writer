{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2024",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "noEmit": true,
    "rootDir": ".",
    // rootDir "." breaks the dist -> src mapping tsc uses for package.json imports
    "paths": { "#crc32": ["./src/crc-node.ts"] }
  },
  "include": [
    "vitest.config.ts",
    "test/**/*.ts",
    "bench/**/*.ts",
    "src/crc-node.ts"
  ]
}
